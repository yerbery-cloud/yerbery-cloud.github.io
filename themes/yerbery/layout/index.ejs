<%
  function plainText(html) {
    return String(html || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
  }
  function summary(post, len) {
    var text = plainText(post.excerpt || post.content);
    return text.length > len ? text.slice(0, len) + '…' : text;
  }
  var posts = page.posts && page.posts.toArray ? page.posts.toArray() : [];
%>



<section class="profile-home shell">

  <div class="home-editorial-rail" aria-hidden="true">
    <span>YERBERY</span>
    <b>個人ブログ</b>
  </div>

