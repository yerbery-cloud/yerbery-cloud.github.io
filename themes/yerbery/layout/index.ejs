<section class="recent-notes-shell shell">

  <header class="notes-heading">
    <div>
      <p class="typography-kicker">
        YERBERY / LATEST WRITING
      </p>
      <h2>Recent Notes <span>/ 近作</span></h2>
    </div>

    <a href="<%= url_for('/archives/') %>" class="notes-archive">
      Archive ↗
    </a>
  </header>

  <div class="notes-list">
    <% posts.slice(0, 6).forEach(function(post) { %>
      <article class="note-entry">

        <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>">
          <%= date(post.date, 'YYYY.MM.DD') %>
        </time>

        <div class="note-entry-main">
          <h3>
            <a href="<%= url_for(post.path) %>">
              <%= post.title %>
            </a>
          </h3>

          <div class="note-entry-meta">
            <% if (post.categories && post.categories.length) { %>
              <% post.categories.each(function(cat) { %>
                <a href="<%= url_for(cat.path) %>">
                  <%= cat.name %>
                </a>
              <% }) %>
            <% } %>
          </div>
        </div>

        <a class="note-open"
           href="<%= url_for(post.path) %>"
           aria-label="阅读 <%= post.title %>">
          ↗
        </a>

      </article>
    <% }) %>
  </div>

</section>

